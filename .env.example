# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
ALLOWED_CHAT_ID=123456789

TZ=Europe/Kyiv

HEARTBEAT_INTERVAL=10

# TTL ключа core:heartbeat, сек (должен быть больше HEARTBEAT_INTERVAL)
HEARTBEAT_TTL=25

# Сколько ждать в зале ожидания Zoom, сек
WAITING_ROOM_TIMEOUT=600

# Период опроса расписания/команд основным циклом core, сек
POLL_INTERVAL=5
